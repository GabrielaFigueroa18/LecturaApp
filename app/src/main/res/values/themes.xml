<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal de LecturaApp -->
    <style name="Base.Theme.LecturaApp"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Colores principales -->
        <item name="colorPrimary">#7135E8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#4C1D95</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Fondo -->
        <item name="android:windowBackground">#F3F1FA</item>

        <!-- Barra superior -->
        <item name="android:statusBarColor">#7135E8</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Barra inferior -->
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Colores del texto -->
        <item name="android:textColorPrimary">#25115E</item>
        <item name="android:textColorSecondary">#55546B</item>

    </style>

    <style name="Theme.LecturaApp"
        parent="Base.Theme.LecturaApp" />

</resources>
