<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F1FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Agregar libro"
            android:textColor="#25115E"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra tu próxima lectura"
            android:textColor="#55546B"
            android:textSize="15sp"
            android:layout_marginTop="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tarjeta"
            android:padding="20dp"
            android:layout_marginTop="22dp">

            <EditText
                android:id="@+id/etTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Título del libro"
                android:inputType="textCapSentences"
                android:textColor="#25115E"
                android:textColorHint="#66627A"/>

            <EditText
                android:id="@+id/etAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Autor"
                android:inputType="textCapWords"
                android:textColor="#25115E"
                android:textColorHint="#66627A"
                android:layout_marginTop="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Género"
                android:textColor="#25115E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <Spinner
                android:id="@+id/spGenero"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/etTotalPaginas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Número total de páginas"
                android:inputType="number"
                android:textColor="#25115E"
                android:textColorHint="#66627A"
                android:layout_marginTop="18dp"/>

            <EditText
                android:id="@+id/etPaginasLeidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Páginas leídas"
                android:inputType="number"
                android:textColor="#25115E"
                android:textColorHint="#66627A"
                android:layout_marginTop="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado de lectura"
                android:textColor="#25115E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <Spinner
                android:id="@+id/spEstado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvCalificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calificación (solo libros terminados)"
                android:textColor="#25115E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <RatingBar
                android:id="@+id/ratingLibro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1"
                android:rating="0"
                android:progressTint="#F59E0B"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnGuardarLibro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar libro"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="#7135E8"
                android:layout_marginTop="25dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
