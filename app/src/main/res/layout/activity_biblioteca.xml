<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F1FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Mi biblioteca"
            android:textColor="#25115E"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu espacio personal de lectura"
            android:textColor="#55546B"
            android:textSize="15sp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvCantidadLibros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total de libros: 0"
            android:textColor="#25115E"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="18dp"
            android:background="@drawable/bg_tarjeta"
            android:layout_marginTop="24dp"/>

        <EditText
            android:id="@+id/etBuscarLibro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por título o autor..."
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#25115E"
            android:textColorHint="#777389"
            android:backgroundTint="#7135E8"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:layout_marginTop="20dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos"
                    android:textAllCaps="false"
                    android:backgroundTint="#7135E8"/>

                <Button
                    android:id="@+id/btnPorLeer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Por leer"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#64748B"/>

                <Button
                    android:id="@+id/btnLeyendo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leyendo"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#64748B"/>

                <Button
                    android:id="@+id/btnTerminados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terminados"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#64748B"/>

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando libros..."
            android:textColor="#55546B"
            android:textSize="14sp"
            android:layout_marginTop="18dp"/>

        <LinearLayout
            android:id="@+id/contenedorLibros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al Dashboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7135E8"
            android:layout_marginTop="25dp"/>

    </LinearLayout>
</ScrollView>
